<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-Tckr.MockExchange-aec27693-dd07-4120-b107-a2ea418c4ec6</UserSecretsId>

        <!-- This process exists to sustain a rate, and it is measured on whether it does. Server GC
             gives the generation loop its own heap and collector thread instead of contending with
             the socket writes for one, and background collection keeps a gen2 out of the middle of
             a benchmark window. The trade is memory the box has and pause time it does not. -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

        <!-- The market session resolves an IANA time zone, which the invariant globalization mode
             would reduce to UTC-only with no error. A benchmark whose phase schedule silently ran
             in the wrong zone is not a result. -->
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10"/>
        <!-- ValidateDataAnnotations(); the Hosting metapackage does not bring it in. -->
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Requested by task 02. SymbolUniverse.Load asks for this manifest resource first and
             falls back to the copy the Worker SDK globs into the output directory, so the build is
             green either way; embedding makes the universe independent of the output layout and
             survives a single-file publish. -->
        <EmbeddedResource Include="Reference\symbols.json"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The unit tests assert on the wire layout and the generation hot path, and the
             probe decodes the feed. Both need the internal protocol types; keeping them
             internal avoids publishing a surface area we do not intend to support. -->
        <InternalsVisibleTo Include="Tckr.MockExchange.Tests"/>
        <InternalsVisibleTo Include="Tckr.FeedProbe"/>
    </ItemGroup>
</Project>
